# Where the FastAPI backend is listening. NEXT_PUBLIC_* values are exposed to
# the browser, so this must never hold a secret -- and it does not need to:
# the UI carries no credentials. Authentication is resolved server-side from
# the identity the request asserts (see app/backend/auth/principals.py).
# Must address the backend by the same host the browser loads this app from.
# `localhost` and `127.0.0.1` are one machine but two registrable hosts, so
# mixing them makes every API call cross-site and the SameSite=Lax session
# cookie is silently dropped — sign-in appears to work and then does not.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Public demo -----------------------------------------------------------
# Nothing to set. The demo credential lives in the backend's configuration, and
# `POST /api/auth/demo-login` takes no body -- so there is no address and no
# password for this file to publish, and none for `next build` to inline into
# the bundle. Whether the sign-in page offers the demo button is answered by
# the backend on `/health` (`demo_login_enabled`), which means it can never
# offer one the backend would refuse.
#
# This used to carry NEXT_PUBLIC_DEMO_EMAIL and NEXT_PUBLIC_DEMO_PASSWORD. They
# are gone. Beyond keeping a credential out of the browser bundle, it removes a
# failure that had no symptom: those values are baked in at build time, so a
# deployment that changed its demo password left the frontend confidently
# posting the old one.
