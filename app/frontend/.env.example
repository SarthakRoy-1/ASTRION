# Where the FastAPI backend is listening. NEXT_PUBLIC_* values are exposed to
# the browser, so this must never hold a secret -- and it does not need to:
# the UI carries no credentials. Authentication is resolved server-side from
# the identity the request asserts (see app/backend/auth/principals.py).
# Must address the backend by the same host the browser loads this app from.
# `localhost` and `127.0.0.1` are one machine but two registrable hosts, so
# mixing them makes every API call cross-site and the SameSite=Lax session
# cookie is silently dropped — sign-in appears to work and then does not.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Public demo (optional) ------------------------------------------------
# Set both, and the sign-in page offers the seeded demo account: address,
# password, and a button that signs in through the ordinary endpoint. Leave
# either unset and no demo panel is rendered at all, which is what a
# self-hosted copy should do.
#
# The password here is PUBLIC by construction -- Next.js inlines NEXT_PUBLIC_*
# into the client bundle -- and that is the point: a public demo means anyone
# may sign in. What makes it safe is that the account is an ordinary member of
# one workspace over synthetic data, with every server-side control intact.
#
# It is deployment configuration, never repository content. It must match
# DEMO_SEED_PASSWORD in the backend's environment (see the root .env.example).
# NEXT_PUBLIC_DEMO_EMAIL=support@demo.astrion.example
# NEXT_PUBLIC_DEMO_PASSWORD=
