{
  "components": {
    "schemas": {
      "ActionConfirmationRequest": {
        "additionalProperties": false,
        "description": "Confirm or reject one prepared action.\n\nConfirmation is a distinct API call with a closed vocabulary. A user typing\n\"okay\" into the chat endpoint does not confirm anything: `/api/chat` has no\npath to execution at all, which is what makes the gate structural rather\nthan a matter of parsing intent correctly.",
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/ConfirmationDecision"
          },
          "expected_fingerprint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Fingerprint"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "required": [
          "decision"
        ],
        "title": "ActionConfirmationRequest",
        "type": "object"
      },
      "ActionConfirmationResponse": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ExecutedActionView"
          },
          "action_status": {
            "$ref": "#/components/schemas/ActionState"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "action_status",
          "action",
          "message"
        ],
        "title": "ActionConfirmationResponse",
        "type": "object"
      },
      "ActionDetailResponse": {
        "properties": {
          "action": {
