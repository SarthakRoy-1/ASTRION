                  "$ref": "#/components/schemas/ActionDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Action Detail",
        "tags": [
          "actions"
        ]
      }
    },
    "/api/actions/{action_id}/confirm": {
      "post": {
        "description": "Execute or reject one prepared action. The only path to a state change.\n\nEvery check the Phase 4 state machine offers is applied, under the\n*confirming* caller rather than the preparing one: the action must exist\nwithin this caller's account scope, belong to this conversation, still be\npending, not have expired, still have a live target, and \u2014 when a\nfingerprint is supplied \u2014 still describe exactly what was reviewed. The\nstatus guard inside the UPDATE makes execution single-use even if two\nconfirmations race.",
        "operationId": "confirm_action_api_actions__action_id__confirm_post",
        "parameters": [
          {
            "in": "path",
            "name": "action_id",
            "required": true,
            "schema": {
              "title": "Action Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-parcelpilot-user",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Parcelpilot-User"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionConfirmationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionConfirmationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm Action",
        "tags": [
          "actions"
        ]
      }
    },
    "/api/chat": {
      "post": {
        "description": "Answer one natural-language request with its evidence.\n\nThe authorization context is built from the caller's identity before the\nmessage is read, and nothing in the message can widen it. Account ids in\nprose are treated as text; the agent's scope comes from records it was\npermitted to resolve.",
        "operationId": "chat_api_chat_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-parcelpilot-user",
            "required": false,
            "schema": {
