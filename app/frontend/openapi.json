  "info": {
    "description": "Natural-language support and operations assistant over ParcelPilot's policy\npack and operational records.\n\nThe agent reasons; deterministic code decides. Account scoping, source\nprecedence, cancellation and service-credit arithmetic, and every state change\nare enforced below the model layer and cannot be influenced by the contents of\na request.\n\nState-changing actions are prepared by `POST /api/chat` and executed only by\n`POST /api/actions/{action_id}/confirm`. Nothing in a chat message can perform\none.\n",
    "title": "ParcelPilot Support & Operations Agent API",
    "version": "0.8.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/actions/pending": {
      "get": {
        "description": "Proposals awaiting confirmation, within the caller's account scope.",
        "operationId": "pending_actions_api_actions_pending_get",
        "parameters": [
          {
            "in": "query",
            "name": "user_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "User Id"
            }
          },
          {
            "in": "header",
            "name": "x-parcelpilot-user",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Parcelpilot-User"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingActionsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pending Actions",
        "tags": [
          "actions"
        ]
      }
    },
    "/api/actions/{action_id}": {
      "get": {
        "description": "The audit record for one action: state, timeline, and its effect.\n\nScoped like every other read \u2014 an action on another customer's account is\nreported as absent, not as forbidden, for the same reason the record\nlayer does.",
        "operationId": "action_detail_api_actions__action_id__get",
        "parameters": [
          {
            "in": "path",
