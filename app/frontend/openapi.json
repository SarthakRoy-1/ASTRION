      "ActionState": {
        "description": "Action lifecycle as the API reports it.\n\nExtends `ActionStatus` with `NONE`, so a response always states the action\nsituation instead of leaving a client to infer it from a null field.\n\n`CONFIRMED` is part of the contract but is not currently emitted: Phase 4's\nstate machine confirms and executes inside one guarded transaction, so a\nsuccessfully confirmed action is already `EXECUTED` by the time anyone can\nobserve it. It is listed here so a future asynchronous executor does not\nneed a breaking contract change.",
        "enum": [
          "none",
          "pending_confirmation",
          "confirmed",
          "executed",
          "rejected",
          "expired",
          "failed"
        ],
        "title": "ActionState",
        "type": "string"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "description": "A natural-language request plus the identity it is made under.\n\n`user_id` establishes the authorization context; it is looked up in the\nmock principal directory server-side. It is *not* trusted to describe its\nown permissions, and nothing in `message` can alter them \u2014\nsee `app/backend/auth/principals.py`.",
        "properties": {
          "account_scope": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Scope"
          },
          "message": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
