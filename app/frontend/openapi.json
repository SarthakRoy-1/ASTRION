      }
    },
    "/api/principals": {
      "get": {
        "description": "The mock identities this deployment accepts, and the scope each holds.\n\nExists so the demo is self-describing. It lists no credentials, because\nthere are none: Phase 5's authentication is deliberately a mock, and a\nreal identity provider replaces `auth/principals.py` without touching\nanything below it.",
