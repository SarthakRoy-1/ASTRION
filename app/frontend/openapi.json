    "/health": {
      "get": {
        "description": "Liveness plus what is actually configured.\n\nAnswers 200 even when the database has not been built, reporting\n`status: \"degraded\"` \u2014 a health check that fails to respond tells an\noperator less than one that responds saying what is missing.",
        "operationId": "health_health_get",
