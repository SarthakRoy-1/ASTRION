# ---------------------------------------------------------------------------
# ASTRION — AI Logistics Support — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit it.
#     cp .env.example .env
#
# Values below are placeholders and defaults only. No real secret belongs in
# this file at any point.
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
# Which planning provider backs the agent. Explicit on purpose -- the app never
# falls back from `real` to `deterministic`, because an operator who asked for a
# live model and silently got a rule-based planner would be running a different
# system than they believe.
#
#   deterministic  Rule-based planner. No API key, no network. This is the
#                  default, it is what CI and the whole test suite run on, and
#                  it exercises every safety boundary in the system.
#   real           OpenAI-backed planner. Requires OPENAI_API_KEY below;
#                  startup fails clearly if it is missing.
LLM_PROVIDER=deterministic

# Required only when LLM_PROVIDER=real. The value below is a placeholder, not a
# credential, and is treated as absent.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o
# Optional: proxy / Azure / compatible gateway. Leave blank for the default.
OPENAI_BASE_URL=

# Guardrails on agent orchestration
AGENT_MAX_TOOL_STEPS=8
AGENT_REQUEST_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0

# --- Backend ---------------------------------------------------------------
# Metadata label only (appears on /health); does not change how or where the
# server binds. Host/port are startup arguments, not environment variables --
# see the uvicorn command in README.md and CMD in Dockerfile.backend.
APP_ENV=development

# Comma-separated origins permitted to call the API. A wildcard is REFUSED at
# startup: it cannot be combined with cookie authentication, and in production
# a plaintext http:// origin is refused too.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# PostgreSQL is the production database:
#
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# The URL carries a password. It belongs in the host's secret store (Render's
# environment), never in Git and never in a NEXT_PUBLIC_* variable. Against
# Supabase use the *pooler* host (IPv4); the direct db.<ref>.supabase.co host is
# IPv6-only. The schema is created by migrations, applied by the deploy step
# (`python -m app.backend.db.migrate`, run by docker-entrypoint.sh) -- never per
# request. DEMO_LOGIN_ENABLED must be false against PostgreSQL.
#
# SQLite (below) remains for local development and the tests. It lives under
# data/processed/ and is a regenerable build artifact.
DATABASE_URL=sqlite:///./data/processed/astrion.db

# Connection pool bounds when DATABASE_URL is PostgreSQL. Each in-flight request
# holds one connection, so size max against the database's connection limit.
# DB_POOL_MIN=1
# DB_POOL_MAX=10

# Uploaded documents. Relative paths resolve against the repository root. Put
# this beside the database on persistent storage if uploads must survive a
# restart; on an ephemeral disk both are lost together.
UPLOADS_DIR=data/uploads

# --- Authentication --------------------------------------------------------
# How a caller's identity is established.
#
#   session      Real authentication. The caller signs in at
#                POST /api/auth/login and receives an HttpOnly session cookie;
#                the server resolves user, organisation, role and tenant scope
#                from its own database. THIS IS THE DEFAULT and the only mode
#                fit to be reachable by anyone but a developer.
#
#   demo_header  The original assessment behaviour: the client asserts an
#                identity in the X-Astrion-User header and the server
#                believes it. There is NO credential -- anyone who can reach
#                the port can claim any identity, including one with
#                all-accounts scope and execution rights. It exists so the demo
#                and the agent test-suite can act as a named persona without a
#                login. The application REFUSES TO START in this mode when
#                APP_ENV names a production environment.
AUTH_MODE=session

# Session cookie. `Secure` must stay true anywhere real: it is what keeps the
# cookie off plaintext connections. Set it false only for local http
# development -- startup refuses false when APP_ENV is production.
SESSION_COOKIE_NAME=astrion_session
SESSION_COOKIE_SECURE=true
# `lax` is the primary CSRF defence: it stops the cookie riding along on a
# cross-site POST. Use `none` only for a genuinely cross-site frontend, and
# only with Secure=true -- the Origin check in api/middleware.py is then the
# control doing the work.
SESSION_COOKIE_SAMESITE=lax

# Require a verified email address before a password may issue a session.
REQUIRE_VERIFIED_EMAIL=true

# --- Email delivery and one-time codes -------------------------------------
# Registration and unverified sign-ins are verified with a six-digit code sent
# by email. See docs/authentication.md for the full design.
#
# Real mail: a Resend API key and a sender on a domain with SPF/DKIM/DMARC.
# RESEND_API_KEY=
# EMAIL_FROM=ASTRION <noreply@your-domain.example>
#
# Local development only: write each email (with its code) to a file in this
# folder instead of sending it. `python dev.py` sets data/outbox by default.
# The backend REFUSES TO START with this set when APP_ENV is production.
# EMAIL_OUTBOX_DIR=data/outbox
#
# Code policy. Every value is enforced server-side.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_MINUTES=60
VERIFICATION_TTL_MINUTES=60

# --- Sign in with Google / GitHub ------------------------------------------
# Both halves of a provider's credential must be set for its button to work.
# Backend only: the secrets never reach the browser, and /health reports only
# which provider names are configured.
#
# Register these callback URLs with the providers, exactly:
#   {API_PUBLIC_URL}/api/auth/oauth/google/callback
#   {API_PUBLIC_URL}/api/auth/oauth/github/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
#
# The public origin of THIS API (forms the callback URL above), and the
# frontend origin the browser returns to afterwards. Both must be https:// in
# production when a provider is configured. Neither can be changed by a
# request, so the callback cannot be turned into an open redirect.
API_PUBLIC_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# NOTE: there is no AUTH_SECRET_KEY. Sessions are opaque random tokens stored
# as SHA-256 digests, not signed stateless tokens, so there is no signing key
# to leak, rotate, or accidentally commit -- and revocation is a database write
# rather than a blocklist. Nothing here needs a shared secret.

# --- Abuse prevention ------------------------------------------------------
# Largest body the server will read at all, enforced before parsing. The 4000
# character cap on a chat message is a schema limit and only applies after a
# body has already been buffered.
MAX_REQUEST_BYTES=262144

RATE_LIMIT_ENABLED=true
# Per client per minute. The agent limit is far tighter because each request
# fans out into model calls; the auth limit is tighter still because those are
# the endpoints an attacker guesses against.
RATE_LIMIT_PER_MINUTE=120
AGENT_RATE_LIMIT_PER_MINUTE=15
AUTH_RATE_LIMIT_PER_MINUTE=10
ORG_AGENT_RATE_LIMIT_PER_MINUTE=60

# --- Browser security ------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
# Enable ONLY when the deployment is actually served over TLS. Announcing HSTS
# from a plaintext origin pins a scheme the site cannot honour and can make it
# unreachable until the browser cache is cleared by hand.
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=63072000

# --- Workspaces ------------------------------------------------------------
# Multi-tenancy is on and has no switch: every tenant-scoped query derives its
# scope from the authenticated session's workspace membership. There is nothing
# to configure here, and that is deliberate -- an "isolation off" flag would be
# a way to ship an accident.
#
# A newly registered user belongs to no workspace and creates one in the UI. To
# attach the *ingested dataset* to a workspace, run:
#
#     python scripts/bootstrap_workspace.py --email you@example.com --name "Acme"
#
# Invitations are created through the API. There is no mail transport, so the
# invitation token is returned in the response when APP_ENV is not production
# and withheld when it is -- deliver it out of band.

# --- Public demo -----------------------------------------------------------
# A hosted deployment running real authentication has no way in for a visitor:
# registration issues a verification link, there is no transport to deliver it,
# and an unverified account cannot sign in. The demo closes that without
# weakening anything -- the demo account is an ordinary account that signs in
# through the ordinary login path, and every server-side control applies to it.
#
# With this on, the application will build what the demo needs *for itself*:
# the schema, the ingested dataset, the indexed documents and the demo
# workspace, on startup and again on any demo sign-in that finds them missing.
# That is what makes the hosted demo survive a cold start on a platform whose
# disk is rebuilt -- nobody has to run an ingestion script by hand.
#
# It is on by default because this application *is* a public demo. Set it to
# false on a self-hosted copy: with it off there is no demo endpoint, no demo
# button on the sign-in page, and the application creates no workspace.
DEMO_LOGIN_ENABLED=true

# The demo account's password. Optional: the backend has a built-in default,
# and nothing here needs to override it.
#
# This is a PUBLISHED credential by design and not a secret -- but it is also
# never shown to anybody. The sign-in page posts to `/api/auth/demo-login`,
# which takes no body; the server supplies its own credential. No response
# carries it and no log line contains it.
#
# `DEMO_SEED_PASSWORD` is read as a fallback, because docker-entrypoint.sh
# already uses that name -- so a container that seeded with one password and an
# application that authenticates with another cannot drift apart.
#
# The demo addresses are fixed and not secret:
#   support@demo.astrion.example       role: support
#   operations@demo.astrion.example    role: operations  (the one-click identity)
#   owner@demo.astrion.example         role: owner
# DEMO_PASSWORD=

# Read only by docker-entrypoint.sh, never by the application. Redundant when
# DEMO_LOGIN_ENABLED=true, since the application seeds the tenant itself; kept
# so a Docker deployment can still seed at boot rather than on first visit.
# Must be exactly "true" to take effect, and is never implied by APP_ENV.
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=replace-me-in-the-deployment

# --- Safety switches -------------------------------------------------------
# State-changing tools always require an explicit human confirmation step.
# This flag is an additional kill switch, not a substitute for that step.
ENABLE_STATE_CHANGING_ACTIONS=true

# --- Frontend (Next.js) ----------------------------------------------------
# NEXT_PUBLIC_* values are exposed to the browser. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
